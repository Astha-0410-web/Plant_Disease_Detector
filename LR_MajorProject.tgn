le":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}}],[{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}}],[{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}}],[{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}},{"style":{"borders":"","font_style":{},"text_color":"","bg_color":"","halign":"left","valign":"top","padding":{"top":10,"right":5,"bottom":10,"left":5},"border_color":""}}]],"model":{"rows":[[{"value":"Paper Title ","cspan":1,"rspan":1,"markup":[1,12]},{"value":"Author ","cspan":1,"rspan":1,"markup":[1,7]},{"value":"Summarized \nAbstract","cspan":1,"rspan":1,"markup":[1,20]},{"value":"Dataset \nused","cspan":1,"rspan":1,"markup":[1,13]},{"value":"Research \nGap","cspan":1,"rspan":1,"markup":[1,13]}],[{"value":"Agriculture Assistant Chatbot","cspan":1,"rspan":1,"markup":[0,29]},{"value":"K Reddy, Sathvik, \nLaya, Sri Harsha.","cspan":1,"rspan":1,"markup":[1,36]},{"value":"The project aims to develop the agriculture sector. \nIt provides knowledge on good agricultural practices. \nThe chatbot integrates ML, AI, and NLP technologies. \nFocuses on crop management, fertilizer dosage, and nutrient requirements. \nIt collaborates with authoritative sources like ICAR. \nThe initiative aims to empower farmers with information.","cspan":1,"rspan":1,"markup":[1,348]},{"value":"The dataset includes various agricultural information like seed names. \nIt contains data on optimal seasons and rainfall requirements. \nInformation on fertilizers and pesticides is also included.","cspan":1,"rspan":1,"markup":[1,195]},{"value":"The paper does not address scalability of the chatbot system.\nLimited exploration of user engagement and feedback mechanisms.\nLack of integration with existing agricultural platforms and tools.\nInsufficient data on long-term impact on farming practices.\nNo discussion on potential challenges in technology adoption.","cspan":1,"rspan":1,"markup":[1,315]}],[{"value":"Role of Artificial Intelligence in Agriculture:\nAn Analysis and Advancements With\nFocus on Plant Diseases","cspan":1,"rspan":1,"markup":[1,105]},{"value":"Ruchi Rani.","cspan":1,"rspan":1,"markup":[1,11]},{"value":"Increased food demand accelerates global plant diseases. \nManual detection of plant diseases is nearly impossible. \nAI offers solutions to farmers' agricultural challenges. \nAI techniques include machine learning and deep learning. \nRecent advancements in AI for plant disease detection are discussed. \nThe paper surveys AI applications and challenges in agriculture.","cspan":1,"rspan":1,"markup":[1,367]},{"value":"Large datasets are required for plant disease detection. \nData scarcity is a significant challenge in agriculture. \nFew-shot learning addresses limited labeled datasets. \nData augmentation techniques enhance dataset size and variety.","cspan":1,"rspan":1,"markup":[1,233]},{"value":"Limited public image datasets for training AI models. \nTransitioning from lab to real-time environments is crucial. \nNeed for high-performance, real-time plant disease detection solutions. \nData scarcity is a significant challenge in agriculture.","cspan":1,"rspan":1,"markup":[1,246]}],[{"value":"Revolutionizing Agriculture: Machine and Deep\nLearning Solutions for Enhanced Crop\nQuality and Weed Control","cspan":1,"rspan":1,"markup":[1,107]},{"value":"Syed Mujtaba, Hass Rizvi,\nAsma Naseer, Shafiq Ur Rehman,\nVolker Gruhn, Shafiq Rehman","cspan":1,"rspan":1,"markup":[1,84]},{"value":"The paper discusses advancements in agricultural technology. \nIt focuses on improving crop quality and productivity. \nMachine Learning and Deep Learning techniques are proposed for weed control. \nVarious statistical and texture features are utilized for weed identification. \nYOLOv8 and other models achieve high accuracy in weed classification. \nThe research emphasizes sustainable and cost-effective agricultural solutions.","cspan":1,"rspan":1,"markup":[1,425]},{"value":"The research uses two datasets: early-crop-weed and CottonWeedID15. \nEarly-crop-weed contains two weeds and two crops. \nCottonWeedID15 includes fifteen different weed species.","cspan":1,"rspan":1,"markup":[1,175]},{"value":"The impact of background areas on model accuracy is overlooked. \nVariations in lighting conditions affect weed identification performance. \nNeed for expansive annotated datasets is critical. \nAwareness of modern technologies in traditional agriculture is lacking.","cspan":1,"rspan":1,"markup":[1,263]}],[{"value":"Farm’s Smart BOT","cspan":1,"rspan":1,"markup":[1,16]},{"value":"S Geetha, S Balaji","cspan":1,"rspan":1,"markup":[1,18]},{"value":"The paper discusses a smart bot for Indian agriculture. \nIt helps farmers choose suitable crops for their regions. \nThe bot integrates various predictive modules for farming. \nIt utilizes Natural Language Processing for text classification. \nYOLOv3 is used for object detection in crops. \nThe solution is platform independent across multiple operating systems.","cspan":1,"rspan":1,"markup":[1,360]},{"value":"A dataset of 54,306 images was used. \nThe images included diseased and healthy plant leaves.","cspan":1,"rspan":1,"markup":[1,92]},{"value":"Naive Bayes assumes independent predictor features, affecting accuracy. \nExisting chatbots lack platform independence and regional language support. \nCrop rotation suggestions were not adequately focused on. \nChatbots handle only first-level queries, limiting complexity. \nNeed for ongoing review and optimization of chatbot knowledge base.","cspan":1,"rspan":1,"markup":[1,340]}],[{"value":"Smart Agri-Advisor: Integrating Chatbot Technology \nwith CNN-Based Crop Disease Classification for \nEnhanced Agricultural Decision-Making","cspan":1,"rspan":1,"markup":[1,137]},{"value":"Ratna Patil, Yogita Sinkar\nAshish Ruke, Om Kadam,\nHarshvardhan Kulkarni","cspan":1,"rspan":1,"markup":[1,71]},{"value":"The paper presents a smart agricultural decision-making system. \nIt integrates CNN for plant disease classification with 91% accuracy. \nA chatbot enhances user interaction and query resolution. \nMySQL supports community login and knowledge sharing. \nThe system aims to improve plant disease diagnosis and information dissemination.","cspan":1,"rspan":1,"markup":[1,331]},{"value":"Plant Village dataset ","cspan":1,"rspan":1,"markup":[1,22]},{"value":"Future research needed for maximizing integrated solution potential. \nExploration of additional machine learning algorithms for better accuracy. \nUser feedback integration for system refinement is essential.","cspan":1,"rspan":1,"markup":[1,207]}],[{"value":"Generative AI-based Land Cover Classification via\nFederated Learning CNNs: Sustainable \nInsights from UAV Imagery","cspan":1,"rspan":1,"markup":[1,113]},{"value":"Oleksandr Jockusch, Md Zarif Hossain, \nAhmed Imteaj, Abdur R. Shahid","cspan":1,"rspan":1,"markup":[1,68]},{"value":"The paper presents a novel decentralized land cover classification method.\nIt utilizes federated learning and CNNs with UAV imagery.\nHigh-resolution UAV data enables precise land cover classification.\nFederated learning ensures data privacy and reduces bandwidth usage.\nDCGAN generates synthetic images to combat data scarcity.\nThe model achieved over 97% accuracy, improving Vanilla FL by 7%.\nThe approach is applicable in environmental monitoring and urban planning.\nIt promotes sustainability by minimizing extensive data collection needs.","cspan":1,"rspan":1,"markup":[1,542]},{"value":"EuroSAT dataset, contains 27,000 labeled \nLULC images,categorized into 10 classes, \neach having resolution of 64 x 64 pixels.","cspan":1,"rspan":1,"markup":[1,125]},{"value":"Limited exploration of UAV technical failures and their impact.\nInsufficient analysis of adverse weather effects on data collection.\nNeed for more extensive datasets for model validation.\nLack of real-world application case studies for proposed methods.\nPotential biases in synthetic image generation not addressed.","cspan":1,"rspan":1,"markup":[1,315]}],[{"value":"Plant Disease Identification Based on\n Multimodal Learning","cspan":1,"rspan":1,"markup":[1,58]},{"value":"Johnson Kolluri, Sandeep Dash, \nRanjita Das","cspan":1,"rspan":1,"markup":[1,43]},{"value":"The paper discusses advancements in multimedia learning and computer vision. \nIt focuses on deep multimodal learning and data integration. \nA dataset of 54,000 plant images is utilized for analysis. \nThe model identifies 14 plants and 26 diseases effectively. \nAchieved a training accuracy rate of 99.06%. \nEmphasizes the importance of large public image datasets.","cspan":1,"rspan":1,"markup":[1,364]},{"value":"PlantVillage dataset, contains 54,303 images of \nhealthy and unhealthy leaves, categorized into\n 38 species and disease categories.","cspan":1,"rspan":1,"markup":[1,131]},{"value":"Recent advances in deep multimodal learning are not fully addressed. \nLimited significant recent work directly references this research field. \nNeed for thorough review and synthesis of prior work. \nChallenges in multimodal representation for bidirectional learning remain.","cspan":1,"rspan":1,"markup":[1,273]}]]},"theme":null,"fixed_layout":false,"markup":{"instances":[{},{"style":{"fontWeight":"","fontStyle":"","textDecoration":"","color":"","backgroundColor":""}},null]},"options":{"table_caption":"","table_label":"tab:my-table"}}